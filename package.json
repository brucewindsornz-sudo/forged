{
  "name": "forged",
  "productName": "Forged",
  "version": "1.0.2",
  "description": "A layered photo editor for macOS",
  "main": "src/main.js",
  "author": "New Zee Build",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:arm64": "electron-builder --mac --arm64",
    "dist:x64": "electron-builder --mac --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "1.48"
  },
  "build": {
    "appId": "net.newzeebuild.forged",
    "productName": "Forged",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "fileAssociations": [
        {
          "ext": "forged",
          "name": "Forged Project",
          "role": "Editor"
        },
        {
          "ext": "pdf",
          "name": "PDF Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": [
            "png",
            "jpg",
            "jpeg",
            "webp"
          ],
          "name": "Image",
          "role": "Editor"
        }
      ],
      "artifactName": "Forged-${version}-${arch}-mac.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brucewindsornz-sudo/forged.git"
  },
  "homepage": "https://github.com/brucewindsornz-sudo/forged"
}
