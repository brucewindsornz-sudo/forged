{
  "name": "Forged",
  "short_name": "Forged",
  "description": "Layered photo editor, self-hosted",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#151619",
  "theme_color": "#151619",
  "icons": [
    { "src": "web/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "web/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-forged": [".forged", ".kauri"], "image/*": [".png", ".jpg", ".jpeg", ".webp"], "application/pdf": [".pdf"] } }
  ]
}
